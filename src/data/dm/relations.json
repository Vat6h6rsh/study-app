[
  {
    "id": "dm-relations-1",
    "subject": "dm",
    "topic": "relations",
    "title": "Equality on three elements",
    "source": "Original",
    "priority": "core",
    "difficulty": "foundation",
    "marks": 5,
    "prompt": "On A={1,2,3}, R={(1,1), (2,2), (3,3)}. Decide each listed property, giving definitions or witnesses.",
    "solution": [
      {
        "step": 1,
        "text": "reflexive: yes. All diagonal pairs (1,1),(2,2),(3,3) occur."
      },
      {
        "step": 2,
        "text": "irreflexive: no. (1,1) is present."
      },
      {
        "step": 3,
        "text": "symmetric: yes. Every displayed pair has its reversed pair in the displayed list."
      },
      {
        "step": 4,
        "text": "antisymmetric: yes. No distinct x,y have both (x,y) and (y,x) in the list."
      },
      {
        "step": 5,
        "text": "transitive: yes. Checking each composable pair in the finite list produces an already listed endpoint pair."
      },
      {
        "step": 6,
        "text": "equivalence relation: yes. Reflexivity, symmetry and transitivity all hold."
      },
      {
        "step": 7,
        "text": "partial order: yes. Reflexivity, antisymmetry and transitivity all hold."
      }
    ],
    "conceptNote": "Equivalence means reflexive, symmetric and transitive; partial order replaces symmetry with antisymmetry. Classes are relative to the specified universe.",
    "type": "properties",
    "options": [
      "reflexive",
      "irreflexive",
      "symmetric",
      "antisymmetric",
      "transitive",
      "equivalence relation",
      "partial order"
    ],
    "answer": {
      "reflexive": true,
      "irreflexive": false,
      "symmetric": true,
      "antisymmetric": true,
      "transitive": true,
      "equivalence relation": true,
      "partial order": true
    },
    "verification": {
      "kind": "relation",
