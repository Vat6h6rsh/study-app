  {
    "id": "dm-trap-5",
    "subject": "dm",
    "topic": "relations",
    "title": "Antisymmetric is not asymmetric",
    "source": "Original",
    "priority": "core",
    "difficulty": "standard",
    "marks": 5,
    "prompt": "Which relation on {1,2} is both symmetric and antisymmetric?",
    "solution": [
      {
        "step": 1,
        "text": "Symmetry requires every reversed pair."
